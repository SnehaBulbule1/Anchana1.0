{
  "version": 2,
  "builds": [
    {
      "src": "backend.py",
      "use": "@vercel/python",
      "config": {
        "requirementsPath": "backend-requirements-vercel.txt"
      }
    }
  ],
  "routes": [
    { "src": "/analyze-file", "dest": "backend.py" },
    { "src": "/evaluate", "dest": "backend.py" }
  ]
}