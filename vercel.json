{
  "version": 2,
  "builds": [
    {
      "src": "backend.py",
      "use": "@vercel/python",
      "config": {
        "requirementsPath": "backend-requirements-vercel.txt"
      }
    }
  ],
  "routes": [
    { "src": "/api/analyze-file", "dest": "backend.py" },
    { "src": "/api/evaluate", "dest": "backend.py" },
    { "src": "/(.*)", "dest": "index.html" }
  ]
}