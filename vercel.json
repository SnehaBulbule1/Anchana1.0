{
  "version": 2,
  "builds": [
    {
      "src": "backend.py",
      "use": "@vercel/python"
    },
    {
      "src": "frontend.py",
      "use": "vercel-streamlit-builder"
    }
  ],
  "routes": [
    { "src": "/analyze-file", "dest": "backend.py" },
    { "src": "/evaluate", "dest": "backend.py" },
    { "src": "/(.*)", "dest": "frontend.py" }
  ]
}