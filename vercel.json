{
  "version": 2,
  "builds": [
    {
      "src": "backend.py",
      "use": "@vercel/python"
    },
    {
      "src": "app.js",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/app.js",
      "dest": "/app.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "backend.py"
    },
    {
      "src": "/analyze-file",
      "dest": "backend.py"
    },
    {
      "src": "/evaluate",
      "dest": "backend.py"
    },
    {
      "src": "/(.*)",
      "dest": "backend.py"
    }
  ]
}
